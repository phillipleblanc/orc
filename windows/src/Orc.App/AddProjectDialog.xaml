<ContentDialog
    x:Class="Orc.Win.AddProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Project"
    PrimaryButtonText="Add Project"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnAdd">

    <StackPanel Spacing="12" MinWidth="480">
        <TextBlock Text="Choose a folder on the host for your sessions." TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Header="Folder" PlaceholderText="/Users/you/code/project" TextChanged="OnPathChanged"
                     KeyDown="OnPathKeyDown" />
            <Button x:Name="UpButton" Grid.Column="1" VerticalAlignment="Bottom" Click="OnUp" Padding="10,8"
                    ToolTipService.ToolTip="Enclosing folder" AutomationProperties.Name="Enclosing folder">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
        </Grid>
        <Grid x:Name="Browser" Height="260" CornerRadius="6" BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="Folders" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnFolderClick"
                      AutomationProperties.Name="Folders">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="BrowserNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                       TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <ProgressRing x:Name="ListingRing" Width="24" Height="24" IsActive="False" />
        </Grid>
        <CheckBox x:Name="MakeDefault" Content="Use for new sessions by default" IsChecked="True" />
        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False" />
    </StackPanel>
</ContentDialog>
