<Window
    x:Class="Orc.Win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Orc">

    <!-- Native chrome over Mica that follows the Windows theme and accent; only the terminal pane has terminal colors. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar, extended into the window; the system draws the caption buttons at its right. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="Orc" Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,4,8,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Sessions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="HostText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="NewSessionButton" Grid.Column="1" Click="OnNewSessionClick" IsEnabled="False"
                            Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="New session (Ctrl+Shift+N)" AutomationProperties.Name="New session">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </Grid>
                <ListView x:Name="SessionList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSessionSelected"
                          ContextRequested="OnSessionContextRequested" AutomationProperties.Name="Sessions">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5" ColumnSpacing="10" Margin="{Binding Indent}" ToolTipService.ToolTip="{Binding StatusLabel}"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Visibility="{Binding DotVisibility}" />
                                    <ProgressRing Width="12" Height="12" MinWidth="12" MinHeight="12" Foreground="#d29922"
                                                  IsActive="{Binding IsActive}" Visibility="{Binding RingVisibility}" />
                                    <TextBlock Text="!" FontSize="9" FontWeight="Bold" Foreground="#0d1117" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Grid.RowSpan="2" Click="OnToggleChildren" Visibility="{Binding ChevronVisibility}"
                                        Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{Binding ChevronLabel}" AutomationProperties.Name="{Binding ChevronLabel}">
                                    <FontIcon Glyph="{Binding ChevronGlyph}" FontSize="10" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </Grid>

            <!-- The content layer, as Windows 11 apps draw it: a card edge and rounded corner against the Mica pane. -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0" Background="#0d1117"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <WebView2 x:Name="Web" Visibility="Collapsed" />
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="32" Foreground="#6e7681" />
                        <TextBlock x:Name="EmptyText" Text="Select a session" Foreground="#8b949e" HorizontalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                    <InfoBar x:Name="NoticeBar" Margin="12" VerticalAlignment="Top" IsOpen="False" IsClosable="True" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
