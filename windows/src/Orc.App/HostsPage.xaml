<UserControl
    x:Class="Orc.Win.HostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <ScrollViewer>
            <StackPanel Padding="40,28,40,40" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                <Grid>
                    <TextBlock Text="Host" Style="{StaticResource TitleTextBlockStyle}" />
                    <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClose"
                            Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Close"
                            AutomationProperties.Name="Close host settings">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>
                <TextBlock Text="This PC shows and drives the Orc sessions of a host on your network, such as your Mac."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border x:Name="HostCard" Padding="20" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse x:Name="StateDot" Width="10" Height="10" />
                                <ProgressRing x:Name="StateRing" Width="12" Height="12" MinWidth="12" MinHeight="12" IsActive="False" />
                            </Grid>
                            <TextBlock x:Name="HostName" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StateText" Grid.Column="2" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="32" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Address" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AddressText" Grid.Column="1" IsTextSelectionEnabled="True" />
                            <TextBlock Grid.Row="1" Text="Host key" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="KeyText" Grid.Row="1" Grid.Column="1" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" />
                            <TextBlock Grid.Row="2" Text="Runs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PlatformText" Grid.Row="2" Grid.Column="1" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Change address…" Click="OnChangeAddress" />
                            <Button Content="Pair again…" Click="OnPairAgain" />
                            <Button Content="Forget host…" Click="OnForget" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="PairForm" Spacing="12">
                    <TextBlock x:Name="PairTitle" Text="Pair with a host" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="PairStep" TextWrapping="Wrap" />
                    <Grid CornerRadius="6" BorderThickness="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,10,72,10">
                            <TextBlock x:Name="CommandText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True"
                                       VerticalAlignment="Center" />
                        </ScrollViewer>
                        <Button x:Name="CopyButton" Content="Copy" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                Click="OnCopyCommand" AutomationProperties.Name="Copy the command" />
                    </Grid>
                    <Expander Header="Orc on the host doesn't have pair-computer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Orc from before computer pairing: update it, or run this in Terminal on the host instead. It prints a pairing link for this PC at the host's network address."
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid CornerRadius="6" BorderThickness="1" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,10,72,10">
                                    <TextBlock x:Name="LegacyCommandText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                                <Button x:Name="LegacyCopyButton" Content="Copy" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                        Click="OnCopyLegacyCommand" AutomationProperties.Name="Copy the command for an older host" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="2. Paste the link here. It lets this PC control the host's sessions, so keep it private."
                               TextWrapping="Wrap" />
                    <PasswordBox x:Name="LinkBox" PlaceholderText="orca://pair?code=…" PasswordRevealMode="Peek"
                                 PasswordChanged="OnLinkChanged" KeyDown="OnLinkKeyDown" AutomationProperties.Name="Pairing link" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                                Click="OnConnect" />
                        <Button x:Name="CancelPairButton" Content="Cancel" Visibility="Collapsed" Click="OnCancelPair" />
                        <ProgressRing x:Name="Verifying" Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                    </StackPanel>
                    <InfoBar x:Name="PairError" Severity="Error" IsClosable="False" IsOpen="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
