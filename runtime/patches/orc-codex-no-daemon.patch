+import { describe, expect, it } from 'vitest'
+import { buildAgentResumeLaunchCommand } from './agent-resume-launch-command'
+import { resolveAgentLaunchCommand } from './tui-agent-launch-command'
+import { tokenizeStartupCommand } from './tui-agent-startup-shell'
+
+describe('Orc Codex launch isolation', () => {
+  it('preserves isolation through worker options and resume', () => {
+    const shell = 'posix'
+    const launch = resolveAgentLaunchCommand({
+      agent: 'codex',
+      cmdOverrides: {},
+      platform: 'darwin',
+      shell,
+      agentArgs: '--sandbox workspace-write',
+      sessionOptions: { model: 'test-model' },
+      sessionOptionsOverrideAgentArgs: true
+    })
+    expect(launch.ok).toBe(true)
+    if (!launch.ok) throw new Error(launch.error)
+    const command = buildAgentResumeLaunchCommand(
+      'codex',
+      launch.command,
+      ['codex', 'resume', 'test-session'],
+      shell
+    )
+    const parsed = tokenizeStartupCommand(command, shell)
+    expect(parsed.ok).toBe(true)
+    if (!parsed.ok) throw new Error(parsed.error)
+    expect(parsed.tokens).toEqual([
+      'codex',
+      '--no-daemon',
+      '--sandbox',
+      'workspace-write',
+      '-m',
+      'test-model',
+      'resume',
+      'test-session'
+    ])
+  })
+
+  it('honors an explicit Codex command override', () => {
+    const launch = resolveAgentLaunchCommand({
+      agent: 'codex',
+      cmdOverrides: { codex: '/custom/codex --profile personal' },
+      platform: 'darwin',
+      shell: 'posix'
+    })
+    expect(launch).toMatchObject({ ok: true, command: '/custom/codex --profile personal' })
+  })
+
+  it.each(['claude', 'pi'] as const)('preserves the %s default', (agent) => {
+    const launch = resolveAgentLaunchCommand({
+      agent,
+      cmdOverrides: {},
+      platform: 'darwin',
+      shell: 'posix'
+    })
+    expect(launch).toMatchObject({ ok: true, command: agent })
+  })
+})
