+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { requireOrcProfile } from './startup/orc-bundled-profile'
+import * as updater from './updater'
+import { loadElectronAutoUpdater } from './electron-updater-loader'
+
+vi.mock('electron', () => ({ app: { getVersion: () => '1.4.212' } }))
+const roots: string[] = []
+afterEach(() => {
+  roots.splice(0).forEach((root) => rmSync(root, { recursive: true, force: true }))
+})
+function profile() {
+  const root = mkdtempSync(join(tmpdir(), 'orc-profile-test-'))
+  roots.push(root)
+  const path = join(root, 'profile')
+  mkdirSync(path)
+  return path
+}
+function mark(path: string, version = '1.4.212') {
+  writeFileSync(
+    join(path, 'orc-runtime-profile.json'),
+    JSON.stringify({
+      schemaVersion: 1,
+      bundleIdentifier: 'dev.phillipleblanc.orc.runtime',
+      runtimeVersion: version
+    })
+  )
+}
+
+describe('Orc-managed runtime', () => {
+  it('refuses an unowned profile and never writes to it', () => {
+    const path = profile()
+    writeFileSync(join(path, 'orca-data.json'), 'existing data')
+    expect(() => requireOrcProfile(path, '1.4.212')).toThrow()
+  })
+  it('accepts an owned profile only at the pinned version', () => {
+    const path = profile()
+    mark(path)
+    expect(requireOrcProfile(path, '1.4.212')).toMatch(/profile$/)
+    expect(() => requireOrcProfile(path, '1.4.211')).toThrow(/migration/)
+    expect(() => requireOrcProfile(path, '1.4.213')).toThrow(/migration/)
+  })
+  it('rejects relative paths and symlink ownership markers', () => {
+    expect(() => requireOrcProfile('relative', '1.4.212')).toThrow(/absolute/)
+    const path = profile()
+    const other = profile()
+    mark(other)
+    symlinkSync(join(other, 'orc-runtime-profile.json'), join(path, 'orc-runtime-profile.json'))
+    expect(() => requireOrcProfile(path, '1.4.212')).toThrow(/regular/)
+  })
+  it('reports manual updates and rejects every update mutation', async () => {
+    expect(updater.getRemoteServerUpdaterSnapshot('runtime').support).toEqual({
+      installMode: 'unsupported-headless-serve',
+      automatic: false,
+      reason: 'manual-service-update-required'
+    })
+    for (const action of [
+      () => updater.checkForRemoteServerUpdate('runtime'),
+      () => updater.downloadRemoteServerUpdate('runtime'),
+      () => updater.installRemoteServerUpdate('runtime'),
+      updater.checkForUpdatesFromMenu,
+      updater.downloadUpdate,
+      updater.quitAndInstall,
+      loadElectronAutoUpdater
+    ]) {
+      expect(action).toThrow(/Update Orc/)
+    }
+    updater.checkForUpdates()
+    expect(updater.isQuittingForUpdate()).toBe(false)
+    expect(await updater.listAvailableReleaseBuilds('stable')).toEqual([])
+    expect(updater.getUpdateStatus()).toEqual({ state: 'idle' })
+  })
+})
