+import { lstatSync, readFileSync, realpathSync } from 'node:fs'
+import { isAbsolute, join } from 'node:path'
+
+export function requireOrcProfile(path: string | undefined, version: string): string {
+  if (!path || !isAbsolute(path)) {
+    throw new Error(
+      'Orc runtime requires an absolute ORCA_USER_DATA_PATH for an Orc-managed profile.'
+    )
+  }
+  const profile = realpathSync(path)
+  const marker = join(profile, 'orc-runtime-profile.json')
+  if (!lstatSync(marker).isFile()) {
+    throw new Error('Orc runtime requires a regular profile ownership file.')
+  }
+  const owner = JSON.parse(readFileSync(marker, 'utf8'))
+  if (owner.schemaVersion !== 1 || owner.bundleIdentifier !== 'dev.phillipleblanc.orc.runtime') {
+    throw new Error(
+      'This profile is not owned by the bundled Orc runtime. Use a separate Orc profile.'
+    )
+  }
+  if (owner.runtimeVersion !== version) {
+    throw new Error(
+      'Orc profile version differs from this runtime. An explicit profile migration is required.'
+    )
+  }
+  return profile
+}
