@@ -0,0 +1,28 @@
+import { app } from 'electron'
+import { realpathSync } from 'node:fs'
+import { argvRequestsServeMode } from './serve-mode-argv'
+import { requireOrcProfile } from './orc-bundled-profile'
+
+try {
+  if (!argvRequestsServeMode(process.argv)) {
+    throw new Error('The bundled Orc runtime only supports serve mode.')
+  }
+  const profile = requireOrcProfile(process.env.ORCA_USER_DATA_PATH, app.getVersion())
+  const requested = app.commandLine.getSwitchValue('user-data-dir')
+  if (requested && realpathSync(requested) !== profile) {
+    throw new Error('The user-data-dir flag must match the Orc-managed profile.')
+  }
+  app.setPath('userData', profile)
+  app.setName('Orc Runtime')
+  process.env.ORCA_USER_DATA_PATH = profile
+  process.env.ORCA_BACKGROUND_LAUNCH = '1'
+  if (process.platform === 'darwin') {
+    app.setActivationPolicy('accessory')
+  }
+} catch (error) {
+  console.error(
+    '[orc-runtime]',
+    error instanceof Error ? error.message : 'Invalid runtime profile.'
+  )
+  app.exit(1)
+}
