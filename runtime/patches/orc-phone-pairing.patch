+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { join } from 'node:path'
+import { tmpdir } from 'node:os'
+import { OrcaRuntimeRpcServer } from './runtime/runtime-rpc'
+import { DeviceRegistry } from './runtime/device-registry'
+import { createMobileRpcSurfaceRuntime } from './runtime/runtime-rpc-mobile-method-allowlist-fixtures'
+
+vi.mock('./runtime/pairing-network-interfaces', () => ({
+  getPairingNetworkInterfaces: async () => [{ name: 'utun0', address: '100.64.1.2' }]
+}))
+const roots: string[] = []
+afterEach(() => {
+  roots.splice(0).forEach((root) => rmSync(root, { recursive: true, force: true }))
+})
+function fixture() {
+  const userDataPath = mkdtempSync(join(tmpdir(), 'orc-phone-test-'))
+  roots.push(userDataPath)
+  const { runtime } = createMobileRpcSurfaceRuntime()
+  const server = new OrcaRuntimeRpcServer({ runtime, userDataPath, enableWebSocket: false })
+  const registry = new DeviceRegistry(userDataPath)
+  server['deviceRegistry'] = registry
+  const create = vi.spyOn(server, 'createMobilePairingOffer').mockResolvedValue({
+    available: true,
+    pairingUrl: 'private-test-link',
+    endpoint: 'ws://100.64.1.2:6767',
+    deviceId: 'phone',
+    webClientUrl: null,
+    connectionMode: 'local-only'
+  })
+  const call = (method: string, params = {}, authToken = server['authToken']) =>
+    server['handleMessage'](JSON.stringify({ id: 'test', method, params, authToken }))
+  return { server, registry, create, call }
+}
+
+describe('Orc local phone pairing', () => {
+  it('requires local authentication before minting a mobile-only grant', async () => {
+    const { call, create } = fixture()
+    expect(await call('orc.phone.create', { address: '100.64.1.2' }, 'wrong')).toMatchObject({
+      ok: false,
+      error: { code: 'unauthorized' }
+    })
+    expect(create).not.toHaveBeenCalled()
+    expect(await call('orc.phone.create', { address: '100.64.1.2' })).toMatchObject({
+      ok: true,
+      result: { scope: 'mobile' }
+    })
+    expect(create).toHaveBeenCalledWith({
+      address: '100.64.1.2',
+      connectionMode: 'local-only',
+      name: 'Phone'
+    })
+  })
+  it('rejects loopback, unavailable addresses and caller-selected scopes before mutation', async () => {
+    const { call, create } = fixture()
+    for (const params of [
+      { address: '127.0.0.1' },
+      { address: '192.0.2.1' },
+      { address: '100.64.1.2', scope: 'runtime' }
+    ]) {
+      expect(await call('orc.phone.create', params)).toMatchObject({
+        ok: false,
+        error: { code: 'invalid_params' }
+      })
+    }
+    expect(create).not.toHaveBeenCalled()
+  })
+  it('lists mobile grants without credentials and cannot revoke local Orc access', async () => {
+    const { call, registry } = fixture()
+    const local = registry.addDevice('Orc', 'runtime')
+    const phone = registry.addDevice('Phone', 'mobile')
+    const response = await call('orc.phone.status')
+    expect(response).toMatchObject({
+      ok: true,
+      result: { devices: [{ deviceId: phone.deviceId }] }
+    })
+    expect(JSON.stringify(response)).not.toContain(phone.token)
+    expect(JSON.stringify(response)).not.toContain(local.deviceId)
+    expect(await call('orc.phone.revoke', { deviceId: local.deviceId })).toMatchObject({
+      ok: false
+    })
+    expect(registry.getDevice(local.deviceId)).toBeDefined()
+  })
+  it('does not echo credential-bearing exceptions', async () => {
+    const { call, create } = fixture()
+    create.mockRejectedValue(new Error('secret-credential'))
+    expect(JSON.stringify(await call('orc.phone.create', { address: '100.64.1.2' }))).not.toContain(
+      'secret-credential'
+    )
+  })
+  it('does not expose pairing management to mobile or runtime WebSocket clients', async () => {
+    const { server, registry, create } = fixture()
+    for (const scope of ['mobile', 'runtime'] as const) {
+      const device = registry.addDevice('Remote', scope)
+      for (const method of ['orc.phone.status', 'orc.phone.create', 'orc.phone.revoke']) {
+        const replies: unknown[] = []
+        await server['handleWebSocketMessage'](
+          JSON.stringify({
+            id: 'test',
+            method,
+            deviceToken: device.token,
+            params: { address: '100.64.1.2' }
+          }),
+          (reply) => {
+            replies.push(JSON.parse(reply))
+          },
+          () => {}
+        )
+        expect(replies[0]).toMatchObject({
+          ok: false,
+          error: { code: scope === 'mobile' ? 'forbidden' : 'method_not_found' }
+        })
+      }
+    }
+    expect(create).not.toHaveBeenCalled()
+  })
+})
