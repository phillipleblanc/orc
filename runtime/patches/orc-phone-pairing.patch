+import { z } from 'zod'
+import type { OrcaRuntimeRpcServer } from './runtime-rpc'
+import type { RpcRequest, RpcEnvelopeMeta } from './rpc/core'
+import { errorResponse, successResponse } from './rpc/errors'
+import { getPairingNetworkInterfaces } from './pairing-network-interfaces'
+import { selectAutoAdvertisedPairingAddress } from '../../shared/pairing-address-auto-selection'
+
+const empty = z.object({}).strict()
+const create = z
+  .object({ address: z.string().min(1).max(255), rotate: z.boolean().optional() })
+  .strict()
+const revoke = z.object({ deviceId: z.string().min(1).max(128) }).strict()
+
+// Only the authenticated local socket calls this; paired devices cannot mint grants.
+export async function handleOrcPhonePairing(
+  request: RpcRequest,
+  meta: RpcEnvelopeMeta,
+  server: Pick<
+    OrcaRuntimeRpcServer,
+    'getDeviceRegistry' | 'createMobilePairingOffer' | 'revokeMobileDevice'
+  >
+) {
+  const fail = (code: string, message: string) => errorResponse(request.id, meta, code, message)
+  const success = (result: object) =>
+    successResponse(request.id, meta, {
+      schemaVersion: 1,
+      runtimeId: meta.runtimeId,
+      ...result
+    })
+  try {
+    if (request.method === 'orc.phone.status') {
+      if (!empty.safeParse(request.params ?? {}).success) {
+        return fail('invalid_params', 'Invalid phone status request.')
+      }
+      const interfaces = await getPairingNetworkInterfaces()
+      const devices = (server.getDeviceRegistry()?.listDevices() ?? [])
+        .filter((device) => device.scope === 'mobile')
+        .map(({ deviceId, name, pairedAt, lastSeenAt }) => ({
+          deviceId,
+          name,
+          pairedAt,
+          lastSeenAt
+        }))
+      return success({
+        interfaces,
+        defaultAddress: selectAutoAdvertisedPairingAddress(interfaces) ?? null,
+        devices
+      })
+    }
+    if (request.method === 'orc.phone.create') {
+      const args = create.safeParse(request.params)
+      if (!args.success) {
+        return fail('invalid_params', 'Choose a LAN or Tailscale address from this Mac.')
+      }
+      const interfaces = await getPairingNetworkInterfaces()
+      if (!interfaces.some(({ address }) => address === args.data.address)) {
+        return fail(
+          'invalid_params',
+          'The selected address is unavailable. Refresh the network addresses.'
+        )
+      }
+      const offer = await server.createMobilePairingOffer({
+        ...args.data,
+        connectionMode: 'local-only',
+        name: 'Phone'
+      })
+      if (!offer.available) {
+        return fail(
+          'pairing_unavailable',
+          'Phone pairing is unavailable. Check the runtime network connection and retry.'
+        )
+      }
+      return success({
+        pairingUrl: offer.pairingUrl,
+        endpoint: offer.endpoint,
+        deviceId: offer.deviceId,
+        scope: 'mobile'
+      })
+    }
+    if (request.method === 'orc.phone.revoke') {
+      const args = revoke.safeParse(request.params)
+      if (!args.success) {
+        return fail('invalid_params', 'Choose a phone device ID from the device list.')
+      }
+      if (!(await server.revokeMobileDevice(args.data.deviceId))) {
+        return fail('revoke_failed', 'The phone grant was not revoked. Refresh the device list.')
+      }
+      return success({ revoked: true })
+    }
+    return fail('method_not_found', 'Unknown phone pairing operation.')
+  } catch {
+    // Errors from credential persistence must not echo their input into logs or replies.
+    return fail(
+      'pairing_failed',
+      'Phone pairing did not complete. Refresh the device list before retrying.'
+    )
+  }
+}
